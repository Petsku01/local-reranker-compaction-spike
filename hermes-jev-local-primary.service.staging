[Unit]
Description=Hermes Jev API-Free Local Primary
Documentation=https://github.com/TheoLeeCJ/SemIf
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=HERMES_HOME/hermes-agent
ExecStart=<spike_dir>/.venv311/bin/python HERMES_HOME/hermes-agent/plugins/context_engine/jev_compaction/local_primary_service.py --socket=%t/hermes-jev-local.sock --model=<spike_dir>/hf-cache/models--Qwen--Qwen3.5-4B/snapshots/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a --revision=851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a --device=cuda --dtype=bfloat16 --max-input-tokens=6000
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=30
OOMPolicy=stop
UMask=0077
Environment=HF_HOME=<spike_dir>/hf-cache
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=HERMES_HOME/hermes-agent
Environment=TRITON_CACHE_DIR=<spike_dir>/triton-cache
Environment=XDG_CACHE_HOME=<spike_dir>/runtime-cache
Nice=10
CPUWeight=10
IOWeight=10
CPUQuota=400%
MemoryMax=16G
TasksMax=256
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateNetwork=yes
PrivateDevices=no
KeyringMode=private
RestrictNamespaces=yes
RestrictRealtime=yes
IPAddressDeny=any
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t <spike_dir>/triton-cache <spike_dir>/runtime-cache
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
